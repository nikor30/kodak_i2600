# Vendor drivers, installers, firmware: never commit
vendor/*
!vendor/README.md
*.exe
*.msi
*.iso
*.cab
*.deb
*.rpm
*.tar.gz

# Ghidra/IDA databases can embed vendor code
*.gpr
*.rep/
*.idb
*.i64

# Build output
build/
*.o
*.so
__pycache__/
*.pyc

# Local scan output
scans/

# Phase 1 diagnostic output (review before committing selected files)
pi/phase1/phase1-*/
pi/phase1/phase1-*.tar.gz
pi/phase1/*.log

# Raw USB captures (contain vendor firmware and scanned documents)
captures/local/
