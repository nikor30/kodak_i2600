+// glibc's dlopen() handle *is* the library's struct link_map, and some
+// programs rely on it: they walk ((struct link_map*)dlopen(NULL, ...))->l_next
+// to find their own module and then pass that link_map to dlsym() (the Kodak
+// i2000 scanner driver does this). So dlopen(NULL) returns the main program's
+// link_map, and any link_map from the chain is accepted as a handle.
+static size_t dl_find_idx(dlprivate_t *dl, linkmap_t* lm)
+{
+    for (size_t i=MIN_NLIB; i<dl->lib_sz; ++i)
+        if(dl->dllibs[i].full && (lm->l_lib?(dl->dllibs[i].lib==lm->l_lib):dl->dllibs[i].is_self))
+            return i+1;
+    return 0;
+}
+void* my_dlopen(x64emu_t* emu, void *filename, int flag);
+static size_t dl_handle2nlib(void* handle)
+{
+    dlprivate_t *dl = my_context->dlprivate;
+    if(!handle || !dl)
+        return (size_t)handle;
+    linkmap_t* lm = my_context->linkmap;
+    while(lm && (void*)lm!=handle)
+        lm = lm->l_next;
+    if(!lm)
+        return (size_t)handle;   // a regular index handle
+    size_t idx = dl_find_idx(dl, lm);
+    if(!idx) {
+        // loaded as a dependency and never dlopen()ed: register it (RTLD_NOLOAD|RTLD_LAZY)
+        my_dlopen(thread_get_emu(), lm->l_lib?lm->l_lib->path:NULL, lm->l_lib?0x5:0x1);
+        idx = dl_find_idx(dl, lm);
+    }
+    return idx?idx:(size_t)handle;
+}
+static void* dl_self_handle(void* idx_handle)
+{
+    linkmap_t* lm = getLinkMapLib(NULL);    // main program
+    return lm?(void*)lm:idx_handle;
+}
